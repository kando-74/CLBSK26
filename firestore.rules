rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read the whitelist to check their status
    match /authorizedEmails/{email} {
      allow read: if request.auth != null;
    }
    
    // Allow authenticated users to read profile list, but only write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Authenticated data access
    match /boardTables/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /boardPlays/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /libraryEntries/{entryId} {
      allow read, write: if request.auth != null;
    }
    match /activityLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

