{
    "functions": {
        "predeploy": [
            "npm --prefix functions install",
            "npm --prefix functions run build"
        ],
        "source": "functions"
    },
    "hosting": {
        "public": "frontend/dist",
        "predeploy": [
            "npm --prefix frontend run build"
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    }
}